# Copy this file to .env and fill in real values.
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
MODEL_ID="moonshotai/kimi-k2.5"
OPENROUTER_PROVIDER=""
# Optional complete JSON override for one run's model limits. Leave empty to
# use the built-in catalog. Example: {"context_window_tokens":262144,"max_input_tokens":192000,"max_output_tokens":128000}
MODEL_LIMITS_OVERRIDE=""
# Optional independent model/provider for post-eval process judging.
JUDGE_MODEL_ID=""
JUDGE_PROVIDER=""
# Optional final directory for session JSONL files.
MYCODEAGENT_SESSION_DIR=""
